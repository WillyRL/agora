<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Agora</string>
	<key>CFBundleDisplayName</key><string>Agora</string>
	<key>CFBundleIdentifier</key><string>app.agora.Agora</string>
	<key>CFBundleExecutable</key><string>Agora</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>0.1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<!-- Agora talks to whatever Hermes address you give it, like a browser: `hermes serve` on a tailnet or LAN is plain HTTP (Tailscale encrypts it). -->
	<key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><true/></dict>
	<key>NSHumanReadableCopyright</key><string>Agora — a native client for Hermes Bots.</string>
</dict>
</plist>
